{
  "name": "captionforge",
  "private": true,
  "version": "0.32.0",
  "type": "module",
  "workspaces": [
    "apps/web",
    "packages/*"
  ],
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "start": "node scripts/start.mjs",
    "dev": "node scripts/dev.mjs",
    "dev:web": "npm run dev -w @captionforge/web",
    "dev:api": "node scripts/api.mjs",
    "setup:api": "node scripts/setup.mjs",
    "setup:ai": "node scripts/setup.mjs ai",
    "build": "npm run build -w @captionforge/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present && npm run test:api",
    "test:api": "node scripts/api.mjs test"
  },
  "devDependencies": {
    "typescript": "~6.0.2",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=20"
  }
}
